{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "rewrites": [
    {
      "source": "/((?!api/test-|api/source).*)",
      "destination": "/api/proxy"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": [
        "manga_reader.html",
        "node_modules/tls-impersonate/**"
      ],
      "memory": 1024,
      "maxDuration": 30
    }
  }
}
